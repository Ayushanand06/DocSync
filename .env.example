# Twilio credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
TWILIO_TO_NUMBER=recipient_phone_number_here
TWILIO_VOICE_URL=https://your-public-domain.example.com/twilio/voice

# Groq API keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_JS=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Optional local services
MEDICAL_API_URL=http://127.0.0.1:8000/process-query
WHISPER_MODEL=whisper-large-v3
